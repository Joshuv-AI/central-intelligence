#!/bin/bash
# ci-pull: every 5 min, check GitHub API for new commits and redeploy on change.
# Uses the API (not git fetch) because outbound git HTTPS is blocked in this env.
# Syncs via tar (not rsync) so it works on minimal images without rsync installed.
set -u
REPO=/opt/central-intelligence
LOG=/var/log/ci-pull.log
SHA_FILE=/var/lib/ci-deployed-sha
API_URL="https://api.github.com/repos/Joshuv-AI/central-intelligence/commits/main"

REMOTE_SHA=$(curl -s -m 15 "$API_URL" 2>/dev/null | grep -o '"sha": "[0-9a-f]*"' | head -1 | cut -d'"' -f4)
if [ -z "$REMOTE_SHA" ]; then
  echo "[ci-pull] $(date -u +%FT%TZ) API check failed" >> "$LOG"
  exit 0
fi

LOCAL_SHA=$(cat "$SHA_FILE" 2>/dev/null || echo "none")

if [ "$LOCAL_SHA" != "$REMOTE_SHA" ]; then
  echo "[ci-pull] $(date -u +%FT%TZ) new commit ${REMOTE_SHA:0:12} (was ${LOCAL_SHA:0:12}), deploying" >> "$LOG"
  TMPDIR=$(mktemp -d)
  # Always clean up the temp dir.
  trap 'rm -rf "$TMPDIR"' EXIT
  if curl -sL -m 60 "https://github.com/Joshuv-AI/central-intelligence/archive/$REMOTE_SHA.tar.gz" -o "$TMPDIR/repo.tar.gz"; then
    # Extract directly into $REPO, stripping the tarball's top-level directory.
    # (GitHub archives contain no .git, so the local .git is preserved.)
    # tar is used instead of rsync: rsync isn't installed on minimal images,
    # and a silent rsync failure once caused deploys to report success
    # without updating any files.
    if tar xzf "$TMPDIR/repo.tar.gz" --strip-components=1 -C "$REPO"; then
      echo "$REMOTE_SHA" > "$SHA_FILE"
      echo "[ci-pull] $(date -u +%FT%TZ) extracted ${REMOTE_SHA:0:12}" >> "$LOG"
    else
      echo "[ci-pull] $(date -u +%FT%TZ) extraction FAILED for ${REMOTE_SHA:0:12} - keeping ${LOCAL_SHA:0:12}" >> "$LOG"
      exit 0
    fi
  else
    echo "[ci-pull] $(date -u +%FT%TZ) download FAILED for ${REMOTE_SHA:0:12}" >> "$LOG"
    exit 0
  fi
  install -m 0755 "$REPO/ops/ci-deploy" /usr/local/bin/ci-deploy || echo "[ci-pull] WARNING: ci-deploy install failed" >> "$LOG"
  install -m 0755 "$REPO/ops/ci-pull" /usr/local/bin/ci-pull || echo "[ci-pull] WARNING: ci-pull install failed" >> "$LOG"
  install -m 0755 "$REPO/ops/ci-diagnostic-server.py" /usr/local/bin/ci-diagnostic-server.py || echo "[ci-pull] WARNING: diagnostic server install failed" >> "$LOG"
  export GIT_SHA="$REMOTE_SHA"
  /usr/local/bin/ci-deploy >> "$LOG" 2>&1
  echo "[ci-pull] $(date -u +%FT%TZ) deploy exit $?" >> "$LOG"
fi
